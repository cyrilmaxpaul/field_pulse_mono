{
  "name": "fieldpulse",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "dev:api": "pnpm --filter @fieldpulse/api dev",
    "dev:web": "pnpm --filter @fieldpulse/web dev",
    "dev": "pnpm --parallel --filter @fieldpulse/api --filter @fieldpulse/web dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@fieldpulse/shared-types": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3"
  }
}
